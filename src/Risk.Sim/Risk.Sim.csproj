<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup><PackageReference Include="Newtonsoft.Json" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Learning/ultimate-model.json" LogicalName="Risk.Sim.Learning.%(Filename)%(Extension)" />
