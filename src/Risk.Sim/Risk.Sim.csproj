    <EmbeddedResource Include="Learning/ultimate-multiplayer-model.json" LogicalName="Risk.Sim.Learning.%(Filename)%(Extension)" Condition="Exists('Learning/ultimate-multiplayer-model.json')" />
  </ItemGroup>
</Project>
